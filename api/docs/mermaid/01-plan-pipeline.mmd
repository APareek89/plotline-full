%% granularity: full
%% files: app/orchestrator.py, app/agents/runner.py, app/validators.py, app/ccs.py, app/agents/mock.py, app/agents/providers.py
%% Legacy planning lane retained behind API; the campaign front door is diagram10.
flowchart TD
  U["Plan request [FUNCTION]<br/>in: owned creator context<br/>out: validated planning input"]
  RET["Retrieval [FUNCTION]<br/>in: niche and query<br/>out: resolved evidence"]
  P1["Planner [AGENT · gpt-5.4-mini default]<br/>in: context and evidence<br/>out: plan with proposed ratings"]
  V1{"Validation [FUNCTION]<br/>in: structured plan<br/>out: schema, citations and cadence valid?"}
  FB["Feedback [AGENT · gpt-5.4-mini default]<br/>in: accepted plan<br/>out: review, kill flags and fixes"]
  CCS["CCS calculation [FUNCTION]<br/>in: element ratings and weights<br/>out: server-recomputed score"]
  FLAG{"Refinement gate [FUNCTION]<br/>in: kill flags and CCS<br/>out: flagged or CCS at most70?"}
  P2["Refinement [AGENT · gpt-5.4-mini default]<br/>in: flagged subset and feedback<br/>out: revised subset; untouched bytes retained"]
  OPT["Options [AGENT · gpt-5.4-mini default]<br/>in: qualified concepts<br/>out: distinct options per concept"]
  DB["Owner persistence [DATA · PostgreSQL]<br/>in: plan, feedback and options<br/>out: owned plan and concept state"]
  HF["Explicit failure [FUNCTION]<br/>in: exhausted validation attempt<br/>out: safe visible failure"]
  U --> RET --> P1 --> V1
  V1 -->|"invalid; at most2 validation retries"| P1
  V1 -->|"retry budget exhausted"| HF
  V1 -->|"valid"| FB --> CCS --> FLAG
  FLAG -->|"yes; at most1 refinement pass"| P2 --> FB
  FLAG -->|"no"| OPT --> DB
  classDef agent fill:#dbeafe,stroke:#2563eb,color:#0b2a5b;
  classDef fn fill:#dcfce7,stroke:#16a34a,color:#052e16;
  classDef dec fill:#f3e8ff,stroke:#9333ea,color:#2a0a4a;
  classDef term fill:#e5e7eb,stroke:#6b7280,color:#111827;
  classDef ask fill:#cffafe,stroke:#0891b2,color:#083344;
  classDef data fill:#ede9fe,stroke:#7c3aed,color:#2a0a4a;
  class U,RET,CCS fn;
  class P1,FB,P2,OPT agent;
  class V1,FLAG dec;
  class DB data;
  class HF term;
